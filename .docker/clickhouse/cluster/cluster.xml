<?xml version="1.0"?>
<clickhouse>
  <remote_servers>
    <test_cluster>
      <shard>
        <internal_replication>true</internal_replication>
        <replica>
          <host>clickhouse1</host>
          <port>9000</port>
        </replica>
        <replica>
          <host>clickhouse2</host>
          <port>9000</port>
        </replica>
      </shard>
    </test_cluster>
  </remote_servers>

  <zookeeper>
    <node>
      <host>clickhouse1</host>
      <port>9181</port>
    </node>
  </zookeeper>

  <distributed_ddl>
    <path>/clickhouse/test_cluster/task_queue/ddl</path>
  </distributed_ddl>
</clickhouse>
